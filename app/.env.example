# VerifID mobile — local configuration template.
#
# Copy this file to `.env` inside `app/` and set the values for your machine:
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real hosts, tokens or keys.
# `EXPO_PUBLIC_*` values are inlined into the JS bundle at build time, so they
# are NOT secret — only ever put non-sensitive configuration here.
#
# Restart the Expo dev server after changing any value (these are read at
# bundle time, not at runtime).

# Origin of the screening backend — scheme + host + port, NO trailing slash
# and NO /api/v1 suffix (the app appends `/api/v1/screen` itself).
#
# The backend is not deployed yet, so there is no default. Pick the form that
# matches how you are running the app:
#
#   Web browser / iOS simulator (backend on the same machine):
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
#
#   Android emulator (AVD) — 10.0.2.2 is the host machine from inside the VM:
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
#   Physical phone over Wi-Fi — use your computer's LAN IP, NOT localhost.
#   Replace the example below with the address `ipconfig` / `ip addr` reports
#   for your own machine:
#     EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000
EXPO_PUBLIC_API_BASE_URL=

# Optional. Milliseconds to wait for the screening response before giving up.
# Clamped to 5000–300000; defaults to 90000 when unset.
# EXPO_PUBLIC_API_TIMEOUT_MS=90000
